# ───────── Required ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ───────── Control room security (required in production) ─────────
# Secret entry key. The control room returns a 404 page until someone opens
#   https://YOUR-SITE/control-room?key=THIS-VALUE
# once in their browser. Use a long random value (e.g. `openssl rand -hex 24`). If this is empty in production, the control room stays closed.
ADMIN_GATE_KEY=
# Optional tuning
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=60

# ───────── Server-only secrets. NEVER prefix with NEXT_PUBLIC_ and never commit real values ─────────
# Needed for: inviting team members, visit tracking, coupon preview, customer order tracking page.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── AI chatbot (Google Gemini) ─────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # set to a current Gemini model name

# ───────── Placeholders: add when the integration is built (see lib/integrations/) ─────────
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
ENQUIRY_NOTIFY_TO=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
MESSAGING_API_KEY=
MESSAGING_SENDER_ID=
GST_API_USER=
GST_API_PASSWORD=
GST_GSTIN=
FX_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_ANALYTICS_ID=

# ───────── Cloudinary media storage (website images + private PDF documents) ─────────
# Find these in Cloudinary Console > Settings > API Keys.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Server-only secret: NEVER add NEXT_PUBLIC_ to this variable.
CLOUDINARY_API_SECRET=
