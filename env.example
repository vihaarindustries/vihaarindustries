# ───────── Required ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ───────── Control room security (required in production) ─────────
# Secret entry key. The control room returns a 404 page until someone opens
#   https://YOUR-SITE/control-room?key=THIS-VALUE
# once in their browser. Use a long random value (e.g. `openssl rand -hex 24`). If this is empty in production, the control room stays closed.
ADMIN_GATE_KEY=
# Optional tuning
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=60

# ───────── Server-only secrets. NEVER prefix with NEXT_PUBLIC_ and never commit real values ─────────
# Needed for: inviting team members, visit tracking, coupon preview, customer order tracking page.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── AI chatbot (Google Gemini) ─────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # set to a current Gemini model name

# ───────── Email (Brevo) ─────────
# Brevo API key (Brevo -> SMTP & API -> API Keys; starts with xkeysib-). Use the API key, NOT the SMTP key.
EMAIL_PROVIDER_API_KEY=
# Sender shown to customers. The address must be a verified sender / authenticated domain in Brevo.
# Format:  Vihaar Industries <orders@yourdomain.com>
EMAIL_FROM=
# Optional: where customer replies go, and your team inbox for new website enquiries
EMAIL_REPLY_TO=
ENQUIRY_NOTIFY_TO=
# Supabase "Send Email" hook secret (Supabase -> Authentication -> Hooks). Looks like  v1,whsec_xxxxxxxx
# Needed so the sign-up verification email uses the template you edit in Control room -> Email templates.
SEND_EMAIL_HOOK_SECRET=

# ───────── Exchange rates (Control room -> Finance -> Currency rates) ─────────
# The European Central Bank source needs no key. Add either or both of these for extra sources that also cover AED / SAR directly.
EXCHANGERATE_API_KEY=
OXR_APP_ID=
# Any long random text. Lets the daily schedule in vercel.json refresh rates (Vercel sends it automatically).
CRON_SECRET=

# ───────── Placeholders: add when the integration is built (see lib/integrations/) ─────────
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
MESSAGING_API_KEY=
MESSAGING_SENDER_ID=
GST_API_USER=
GST_API_PASSWORD=
GST_GSTIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_ANALYTICS_ID=

# ───────── Cloudinary media storage (website images + private PDF documents) ─────────
# Find these in Cloudinary Console > Settings > API Keys.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Server-only secret: NEVER add NEXT_PUBLIC_ to this variable.
CLOUDINARY_API_SECRET=
